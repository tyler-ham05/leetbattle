{
    "name": "leet-battle",
    "scripts": {
        "install": "npm run install-auth && npm run install-code && npm run install-lobby && npm run install-game && npm run install-queue && npm run install-frontend",
        "install-auth": "cd service/AuthService && npm install",
        "install-code": "cd service/CodeService && npm install",
        "install-lobby": "cd service/LobbyService && npm install",
        "install-game": "cd service/GameService && npm install",
        "install-queue": "cd service/QueueService && npm install",
        "install-frontend": "cd frontend && npm install",
        "start": "npm run start-db && concurrently --kill-others \"npm run start-auth\" \"npm run start-code\" \"npm run start-lobby\" \"npm run start-game\" \"npm run start-queue\" \"npm run start-frontend\"",
        "start-db": "cd service && docker compose --env-file ../.env up -d",
        "end-db": "cd service && docker compose down",
        "start-auth": "cd service/AuthService && npm run dev",
        "start-code": "cd service/CodeService && npm run dev",
        "start-lobby": "cd service/LobbyService && npm run dev",
        "start-game": "cd service/GameService && npm run dev",
        "start-queue": "cd service/QueueService && npm run dev",
        "start-frontend": "cd frontend && npm run dev",
        "insert-game": "cd service/GameService && npm run dev-match --",
        "seed-demo": "cd service/AuthService && npm run seed:demo"
    },
    "devDependencies": {
        "concurrently": "^9.1.0"
    }
}

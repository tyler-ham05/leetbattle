# Copy to .env at the repo root for local (non-Docker) development.
# service/CodeService/src/db.ts, service/AuthService/src/db.ts, and
# service/CodeService/setup/dataset.py all read from here.

POSTGRES_DB=dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CODE_POSTGRES_DB=code_service
AUTH_POSTGRES_DB=auth_service

# Signs the auth-service session JWT. Use a long random value in any
# environment that isn't your own machine.
JWT_SECRET=dev-secret-change-me

# Where auth-service points users for email verification / password reset
# links (console-logged by the dev mailer instead of actually emailed).
FRONTEND_URL=http://localhost:3000
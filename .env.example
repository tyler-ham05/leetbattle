# Copy to .env at the repo root for local (non-Docker) development.
# service/CodeService/src/db.ts, service/AuthService/src/db.ts,
# service/LobbyService/src/db.ts, service/GameService/src/db.ts, and
# service/CodeService/setup/dataset.py all read from here.

POSTGRES_DB=dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CODE_POSTGRES_DB=code_service
AUTH_POSTGRES_DB=auth_service
LOBBY_POSTGRES_DB=lobby_service
GAME_POSTGRES_DB=game_service
SECRET=replace-with-a-generated-64-character-hex-string
LOBBY_PORT=4003
FRONTEND_URL=http://localhost:3000

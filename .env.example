# Copy to .env at the repo root for local (non-Docker) development.
# service/CodeService/src/db.ts, service/AuthService/src/db.ts, and
# service/CodeService/setup/dataset.py all read from here.

POSTGRES_DB=dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CODE_POSTGRES_DB=code_service
AUTH_POSTGRES_DB=auth_service

# 64-byte secret used to encrypt auth-service's JWE sessions (service/AuthService/src/utils/jwe.ts).
# Generate your own for real use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=replace-with-a-generated-64-character-hex-string